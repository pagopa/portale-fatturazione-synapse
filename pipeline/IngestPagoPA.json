								}
							}
						}
					]
				}
			},
			{
				"name": "GetFolders",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "GetItems",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('GetItems').output.childItems",
						"type": "Expression"
					},
					"condition": {
						"value": "@equals(item().type,'Folder')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set source path",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Get source path",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "SourcePath",
					"value": {
						"value": "@activity('Get source path').output.status.Output.result.exitValue",
						"type": "Expression"
					}
				}
			},
