																"value": "@concat(pipeline().parameters.Container_path,'/pagopa_raw/',pipeline().parameters.TabToImport,'/',substring(variables('SinkPath'),0,4),'/',substring(variables('SinkPath'),4,2), '/' ,substring(variables('SinkPath'),6,2))",
																"type": "Expression"
															},
															"type": "string"
														}
													},
													"snapshot": true,
													"sparkPool": {
														"referenceName": "sparkcls01",
