				"typeProperties": {
					"dataset": {
						"referenceName": "fat_stage_parquet",
						"type": "DatasetReference",
						"parameters": {
							"PathFolderFile": {
								"value": "@variables('SourcePath')",
								"type": "Expression"
							}
						}
					},
					"fieldList": [
						"exists"
