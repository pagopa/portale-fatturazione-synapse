					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat('SELECT [MeseContestazione]\n      ,[AnnoContestazione]\n\t  ,''PRIMO SALDO'' as Tipo\nFROM [pfw].[ContestazioniCalendario]\nWHERE DataCalcoloPrimoSecondo = ''',variables('TodayDate'),'''\nUNION \nSELECT [MeseContestazione]\n      ,[AnnoContestazione]\n\t  ,''SECONDO SALDO'' as Tipo\nFROM [pfw].[ContestazioniCalendario]\nWHERE DataVerifica = ''',variables('TodayDate'), '''\n UNION \n SELECT \n      MeseRel as MeseContestazione\n      ,AnnoRel as AnnoContestazione\n      ,''VAR. SEMESTRALE'' as Tipo\nFROM cfg.CalendarioVarSemestrale      \nWHERE DataEsecuzione = ''', variables('TodayDate'),'''')",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "SqlDatabse",
						"type": "DatasetReference",
						"parameters": {
							"TableSql": " ",
							"SchemaSql": " "
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Set Today",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "TodayDate",
					"value": {
						"value": "@utcNow('yyyy-MM-dd')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "ForEach1",
				"type": "ForEach",
				"dependsOn": [
