						"activity": "GetRelToDo",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('GetRelToDo').output.value",
						"type": "Expression"
					},
					"isSequential": false,
					"activities": [
						{
							"name": "ManageRel",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "ManageRel",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"TipoRel": {
										"value": "@item().Tipo",
										"type": "Expression"
									},
									"MeseCompetenza": {
										"value": "@item().MeseContestazione",
										"type": "Expression"
									},
									"AnnoCompetenza": {
										"value": "@item().AnnoContestazione",
										"type": "Expression"
									}
								}
							}
						}
					]
				}
			}
