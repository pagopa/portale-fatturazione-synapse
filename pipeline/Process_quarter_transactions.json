					"pipeline": {
						"referenceName": "CopyToFatPublic",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"tableName": " ",
						"containerName": "pagopa",
						"folderName": "invoices",
						"wildcard": {
							"value": "@concat(\n    split(variables('year_quarter'),'_' )[0],\n    '-q',\n    split(variables('year_quarter'),'_' )[1],\n    '-DetailedReport.csv')",
