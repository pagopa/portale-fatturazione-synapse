					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "pipelineReturnValue",
					"value": [
						{
							"key": "timevars",
							"value": {
								"type": "Expression",
								"content": "@concat(variables('year_month'),',',variables('year_quarter'))"
							}
						}
					],
					"setSystemVariable": true
				}
			},
			{
				"name": "Set year_month",
