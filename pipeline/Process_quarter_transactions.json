					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "year_month",
					"value": {
						"value": "@split(activity('quarter_trx_tables').output.status.Output.result.exitValue, ',')[0]",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set year_quarter",
				"type": "SetVariable",
