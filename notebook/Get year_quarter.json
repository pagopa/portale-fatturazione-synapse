					}
				},
				"source": [
					"date_format = \"%Y-%m-%d\"\r\n",
					"\r\n",
					"current_date = datetime.strptime(today_date, date_format)\r\n",
					"\r\n",
					"# Define time variables\r\n",
					"current_year_month = str(current_date.year) + str(current_date.month).zfill(2)"
				],
				"execution_count": 4
			},
			{
				"cell_type": "code",
				"metadata": {
					"jupyter": {
						"source_hidden": false,
						"outputs_hidden": false
					},
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"if export_trimestrale == True:\r\n",
					"    reference_date = current_date - timedelta(10)\r\n",
					"    reference_quarter = f\"/q{((reference_date.month - 1) // 3 + 1)}\"\r\n",
					"    reference_year = reference_date.year\r\n",
					"    reference_year_quarter = str(reference_year) + \"_\" + str(reference_quarter)\r\n",
					"elif export_trimestrale == False:\r\n",
					"    reference_date = current_date - timedelta(1)\r\n",
					"    reference_quarter = f\"/q{((reference_date.month - 1) // 3 + 1)}\"\r\n",
					"    reference_year = reference_date.year\r\n",
					"    reference_year_quarter = str(reference_year) + \"_\" + str(reference_quarter)"
				],
				"execution_count": 5
