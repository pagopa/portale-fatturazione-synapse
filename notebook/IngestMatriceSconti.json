			{
				"cell_type": "code",
				"source": [
					"from pyspark.sql import functions as F\r\n",
					"from datetime import datetime,date,timedelta\r\n",
					"from pyspark.sql.types import IntegerType, StructType, StructField, StringType, LongType, TimestampType, BooleanType,DoubleType,BinaryType"
				],
				"execution_count": 3
			},
			{
				"cell_type": "code",
				"metadata": {
					"jupyter": {
						"source_hidden": false,
						"outputs_hidden": false
					},
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"# Define the schema\r\n",
					"schema = StructType([\r\n",
					"    StructField(\"kpi_id\", StringType(), True),\r\n",
					"    StructField(\"kpi_threshold\", DoubleType(), True),\r\n",
					"    StructField(\"start\", StringType(), True),\r\n",
					"    StructField(\"end\", StringType(), True),\r\n",
					"    StructField(\"psp_id\", StringType(), True),\r\n",
					"    StructField(\"psp_company_name\", StringType(), True),\r\n",
					"    StructField(\"psp_broker_id\", StringType(), True),\r\n",
					"    StructField(\"psp_broker_company_name\", StringType(), True),\r\n",
					"    StructField(\"perc_kpi\", DoubleType(), True),\r\n",
					"    StructField(\"kpi_outcome\", StringType(), True),\r\n",
					"    StructField(\"dl_event_tms\", LongType(), True),\r\n",
					"    StructField(\"dl_ingestion_tms\", LongType(), True)\r\n",
					"])\r\n",
					"\r\n",
					"# dfNewFile = spark.read.format(\"parquet\")\\\r\n",
					"#                     .schema(schema)\\\r\n",
					"#                     .load(sourcefile)\r\n",
					"\r\n",
					"dfNewFile = spark.read.format(\"csv\")\\\r\n",
					"                    .option(\"header\",\"true\")\\\r\n",
					"                    .option(\"delimiter\", \";\")\\\r\n",
					"                    .schema(schema)\\\r\n",
					"                    .load(sourcefile)\r\n",
					"\r\n",
					"actualTimeStamp = datetime.now()\r\n",
					"dfNewFile = dfNewFile.withColumn(\"LastModified\",  F.lit(actualTimeStamp))\r\n",
					"dfNewFile = dfNewFile.withColumn(\"SourceFile\",  F.lit(sourcefile))"
				],
				"execution_count": 4
			},
			{
				"cell_type": "code",
