					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"path = f'{container_path}/KPMG_report/{reference_year_quarter}/'\r\n",
					"\r\n",
					"df_kpmg_report\\\r\n",
					"    .coalesce(1)\\\r\n",
					"    .write.mode(\"overwrite\")\\\r\n",
					"    .option(\"header\",\"true\")\\\r\n",
					"    .csv(path)"
				],
				"execution_count": 5
			},
			{
				"cell_type": "code",
				"metadata": {
					"jupyter": {
						"source_hidden": false,
