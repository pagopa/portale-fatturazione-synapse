					},
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"filename = str(reference_year) + \"-q\" + str(reference_quarter) + \"-kpmg-import.csv\"\r\n",
					"\r\n",
					"for file in mssparkutils.fs.ls(path):\r\n",
					"    if file.name == '_SUCCESS':\r\n",
					"        mssparkutils.fs.rm(file.path)\r\n",
					"    else:\r\n",
					"        mssparkutils.fs.mv(file.path, path+filename)"
				],
				"execution_count": 6
