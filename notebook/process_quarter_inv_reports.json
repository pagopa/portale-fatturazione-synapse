				},
				"source": [
					"df_kpmg_report = spark.sql(f\"select * from pagopa.kpmg_import where year_quarter = '{reference_year_quarter}'\")\r\n",
					"\r\n",
					"#df_kpmg_report = df_kpmg_report.drop(\"year_quarter\")"
