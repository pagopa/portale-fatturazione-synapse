					"tags": [
						"parameters"
					]
				},
				"source": [
					"tableName = 'pagopa.transaction_raw'\r\n",
					"sourcefile = 'abfss://raw@fatpdls.dfs.core.windows.net/pagopa_raw/gold_invoicing_payments/2025/03/21'"
				],
				"execution_count": 19
			},
			{
				"cell_type": "code",
				"metadata": {
					"jupyter": {
						"source_hidden": false,
						"outputs_hidden": false
					},
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"from pyspark.sql import functions as F\r\n",
					"from pyspark.sql.functions import col, lit\r\n",
					"from pyspark.sql.types import IntegerType, StructType, StructField, StringType, LongType, TimestampType, BooleanType\r\n",
					"from delta.tables import *\r\n",
					"from datetime import datetime,date,timedelta"
				],
				"execution_count": 20
			},
			{
				"cell_type": "code",
				"metadata": {
					"jupyter": {
						"source_hidden": false,
						"outputs_hidden": false
					},
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"dfTransactionTable = DeltaTable.forName(spark, tableName)\r\n",
					"columns = dfTransactionTable.toDF().schema.fieldNames()"
				],
				"execution_count": 27
			},
			{
				"cell_type": "code",
				"metadata": {
					"jupyter": {
						"source_hidden": false,
						"outputs_hidden": false
					},
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"# Define the schema\r\n",
					"schema = StructType([\r\n",
					"    StructField(\"payment_id\", StringType(), True),\r\n",
					"    StructField(\"iuv\", StringType(), True),\r\n",
					"    StructField(\"psp_id\", StringType(), True),\r\n",
					"    StructField(\"psp_name\", StringType(), True),\r\n",
					"    StructField(\"psp_channel_id\", StringType(), True),\r\n",
					"    StructField(\"total_amount\", LongType(), True),\r\n",
					"    StructField(\"payment_date_time\", TimestampType(), True),\r\n",
					"    StructField(\"sorgente\", StringType(), True),\r\n",
					"    StructField(\"isPosFisico\", BooleanType(), True),\r\n",
					"    StructField(\"year\", StringType(), True),\r\n",
					"    StructField(\"month\", StringType(), True),\r\n",
					"    StructField(\"daily\", StringType(), True),\r\n",
					"    StructField(\"dl_processed_tms\", IntegerType(), True),\r\n",
					"    StructField(\"client_id\", StringType(), True),\r\n",
					"    StructField(\"pa_fiscal_code\", StringType(), True),\r\n",
					"    StructField(\"partner_station\", StringType(), True),\r\n",
					"])"
				],
				"execution_count": 22
			},
			{
				"cell_type": "code",
				"metadata": {
					"jupyter": {
						"source_hidden": false,
						"outputs_hidden": false
					},
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"dfNewFile = spark.read.format(\"parquet\").schema(schema).load(sourcefile)\r\n",
					"\r\n",
					"actualTimeStamp = datetime.now()\r\n",
					"dfNewFile = dfNewFile.withColumn(\"LastModified\",  F.lit(actualTimeStamp))\r\n",
					"dfNewFile = dfNewFile.withColumn(\"SourceFile\",  F.lit(sourcefile))"
				],
				"execution_count": 23
			},
			{
				"cell_type": "code",
				"source": [
					"latest_timestamp = dfNewFile.select(F.max(\"dl_processed_tms\")).collect()[0][0]\r\n",
					"dfNewFile = dfNewFile.where(f\"dl_processed_tms = {latest_timestamp}\")"
				],
				"execution_count": 24
			},
			{
				"cell_type": "code",
				"metadata": {
					"jupyter": {
						"source_hidden": false,
						"outputs_hidden": false
					},
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"df_transactions = dfNewFile\\\r\n",
					"    .withColumn(\"processed_timestamp\", F.to_timestamp(col(\"daily\"), \"yyyyMMdd\"))\\\r\n",
					"    .withColumn(\"quarter\", F.quarter(col(\"processed_timestamp\")))\\\r\n",
					"    .withColumn(\"month\", F.substring(\"daily\", 1, 6).cast(\"int\"))\\\r\n",
					"    .withColumn(\"year\", F.year(col(\"processed_timestamp\")))\\\r\n",
					"    .withColumn(\"year_quarter\", F.concat(col(\"year\"), lit(\"_\"), col(\"quarter\")))\\\r\n",
					"    .withColumn(\"giorno\", F.date_format(col(\"payment_date_time\"), \"yyyyMMdd\"))"
				],
				"execution_count": 17
			},
			{
				"cell_type": "code",
				"metadata": {
					"jupyter": {
						"source_hidden": false,
						"outputs_hidden": false
					},
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"# mergedDfTrx = dfTransactionTable.alias(\"target\").merge(\r\n",
					"#     df_transactions.alias(\"source\"),\r\n",
					"#     \"target.payment_id = source.payment_id\"\r\n",
					"# ).whenMatchedUpdateAll().whenNotMatchedInsertAll().execute()"
				],
				"execution_count": 35
			},
			{
				"cell_type": "code",
				"metadata": {
					"jupyter": {
						"outputs_hidden": false
					}
				},
				"source": [
					"update_dict = {c: col(f\"source.{c}\") for c in columns}\r\n",
					"\r\n",
					"dfTransactionTable.alias(\"target\").merge(\r\n",
					"    df_transactions.alias(\"source\"),\r\n",
					"    \"target.payment_id = source.payment_id\"\r\n",
					").whenMatchedUpdateAll().whenNotMatchedInsertAll().execute()"
				],
				"execution_count": 134
			},
