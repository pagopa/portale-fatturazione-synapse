				"source": [
					"This notebook define the function to get the SQL connection_string and connection_properties"
				]
			},
			{
				"cell_type": "code",
				"source": [
					"key_vault_linkedservice = 'KeyVault'\n",
					"kv_secret = 'JdbcConnectionString'\n",
					"sql_linkedservice = 'fat_sql'"
				],
				"execution_count": 1
			},
			{
				"cell_type": "code",
				"source": [
					"def getSQLConnectionString():\n",
					"\n",
					"    # get the connection_string\n",
					"    jdbcUrl = mssparkutils.credentials.getSecretWithLS(key_vault_linkedservice, kv_secret)\n",
					"\n",
					"    # get the access token from the LinkedService\n",
					"    token = TokenLibrary.getConnectionString(sql_linkedservice)\n",
					"    conn_properties = {\n",
					"        \"driver\": \"com.microsoft.sqlserver.jdbc.SQLServerDriver\",\n",
					"        \"accessToken\": token\n",
					"    }\n",
					"\n",
					"    return(jdbcUrl, conn_properties)"
				],
				"execution_count": 2
			}
		]
	}
