						}
					}
				},
				"source": [
					"if df_trx_without_contract[df_trx_without_contract[\"transactions\"]!=0].count() == 0:\r\n",
					"    a = \"-\"\r\n",
					"    gs_trx_without_contract = spark.createDataFrame(pd.DataFrame({\"transactions\": a, \"year\": a, \"quarter\": a, \"psp_id\": a, \"psp_name\": a,\r\n",
					"                                               \"identificativo_canale\": a, \"membership_id\": a, \"year_quarter\": a}, index = [0]))\r\n",
					"\r\n",
					"else:\r\n",
					"    gs_trx_without_contract = df_trx_without_contract"
				],
				"execution_count": null
			},
