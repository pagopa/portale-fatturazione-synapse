			{
				"cell_type": "code",
				"source": [
					"dfInvoicing = spark.sql(\"\"\"SELECT it.iun,it.paid \r\n",
					"                 from fat_delta.invoicing_timeline it \r\n",
					"                 inner join fat_delta.bonificamininterno b on b.iun = it.iun\r\n",
					"                 WHERE it.paid <> 'c9a8ffc1-7337-46a2-aac8-cd7543ea2215'\"\"\")\r\n",
					"\r\n",
					"dfNotification = spark.sql(\"\"\"SELECT n.iun, n.senderpaid\r\n",
					"                from fat_delta.notification n\r\n",
					"                inner join fat_delta.bonificamininterno b on b.iun = n.iun\r\n",
					"                WHERE n.senderpaid <> 'c9a8ffc1-7337-46a2-aac8-cd7543ea2215'\"\"\")   \r\n",
					"\r\n",
					"dfPnTimeline = spark.sql(\"\"\"SELECT pn.iun, pn.paid\r\n",
					"                from fat_delta.pn_timeline pn\r\n",
					"                inner join fat_delta.bonificamininterno b on b.iun = pn.iun\r\n",
					"                WHERE pn.paid <> 'c9a8ffc1-7337-46a2-aac8-cd7543ea2215'\"\"\")    \r\n",
					"\r\n",
					"dtRet = dfInvoicing.union(dfNotification).union(dfPnTimeline)   \r\n",
					"\r\n",
					""
				],
				"execution_count": 1
			},
			{
