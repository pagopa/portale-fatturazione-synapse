					"                                    ,psp_broker_company_name\\\r\n",
					"                                    ,cast(perc_kpi as string)\\\r\n",
					"                                    ,kpi_outcome\\\r\n",
					"                                    ,dl_event_tms\\\r\n",
					"                                    ,dl_ingestion_tms\\\r\n",
