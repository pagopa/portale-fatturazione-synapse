					"              ,CAST(CONCAT(year, RIGHT(CONCAT('0',month),2)) as int) as AnnoMese\r\n",
					"              ,count(*) as NumNotifiche\r\n",
					"              ,sum(cost_eurocent) as CostoNotifiche\r\n",
