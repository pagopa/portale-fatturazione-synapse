					"#### Report Contestate"
				]
			},
			{
				"cell_type": "code",
				"metadata": {
					"jupyter": {
						"source_hidden": false,
						"outputs_hidden": false
					},
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"query = \"\"\"(SELECT \r\n",
					"              presaincarico_data\r\n",
					"              ,tipologia_notifica\r\n",
					"              ,CAST(CONCAT(year, RIGHT(CONCAT('0',month),2)) as int) as AnnoMese\r\n",
					"              ,count(*) as NumNotifiche\r\n",
					"              ,sum(cost_eurocent) as CostoNotifiche\r\n",
					"              ,stato_contestazione\r\n",
					"            FROM (SELECT \r\n",
					"                    CASE WHEN notificationtype = 'DIGITALE' THEN LEFT(notification_sent_at,7)\r\n",
					"                    ELSE LEFT(event_timestamp,7)\r\n",
					"                    END AS presaincarico_data\r\n",
					"                    ,CASE WHEN notificationtype <> 'DIGITALE' THEN 'ANALOGICO'\r\n",
					"                      ELSE 'DIGITALE'\r\n",
					"                    END AS tipologia_notifica\r\n",
					"                    ,cost_eurocent\r\n",
					"                    ,year\r\n",
					"                    ,month\r\n",
					"                    ,CASE WHEN FkIdFlagContestazione in (1,2,9) THEN 'ChiusaFatturabile'\r\n",
					"                        WHEN FkIdFlagContestazione = 8 THEN 'ChiusaNonFatturabile'\r\n",
					"                        WHEN FkIdFlagContestazione in (3,4,5,6,7) THEN 'Pending'\r\n",
					"                    END as stato_contestazione\r\n",
					"                  FROM pfw.Contestazioni c\r\n",
					"                  inner join pfd.Notifiche n on event_id = fkidNotifica\r\n",
					"                  AND n.TipologiaFattura is null) t\r\n",
					"            group by year,month,presaincarico_data,tipologia_notifica, stato_contestazione) as tb\"\"\"\r\n",
					"            \r\n",
					"#dfMatriceRecapitisti = \r\n",
					"dfContestate = spark.read.jdbc(url=jdbcUrl, table=query, properties=conn_Prop)  #.createOrReplaceTempView(\"tmpNotifiche\")"
				],
				"execution_count": null
			},
			{
				"cell_type": "code",
				"metadata": {
					"jupyter": {
						"source_hidden": false,
						"outputs_hidden": false
					},
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"dfContestate = dfPreseInCarico.join(dfContestate, on=[\"presaincarico_data\",\"tipologia_notifica\"],how=\"left\")"
				],
				"execution_count": null
			},
			{
				"cell_type": "code",
				"metadata": {
					"jupyter": {
						"source_hidden": false,
						"outputs_hidden": false
