			{
				"cell_type": "code",
				"source": [
					"dfPreseInCarico = spark.sql(\"\"\"SELECT presaincarico_data,tipologia_notifica, sum(tot_notifiche) tot_notifiche_categoria\r\n",
					"        ,sum(tot_prezzo_ente) totale_valore_categoria\r\n",
					"        FROM fat_delta.allpreseincarico\r\n",
					"        group by presaincarico_data,tipologia_notifica\"\"\")"
				],
				"execution_count": null
			},
			{
				"cell_type": "code",
				"metadata": {
					"jupyter": {
						"source_hidden": false,
						"outputs_hidden": false
					},
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"dfPreseInCaricoTotali = spark.sql(\"\"\"\r\n",
					"SELECT presaincarico_data\r\n",
					"    ,sum(tot_notifiche) as totale_notifiche\r\n",
					"    ,sum(tot_prezzo_ente) as totale_valore\r\n",
					"    FROM fat_delta.allpreseincarico\r\n",
					"    group by presaincarico_data\r\n",
					"\"\"\")"
				],
				"execution_count": null
			},
			{
				"cell_type": "markdown",
				"metadata": {
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"#### Report Perfezionate"
				]
			},
			{
				"cell_type": "code",
				"metadata": {
					"jupyter": {
						"source_hidden": false,
						"outputs_hidden": false
					},
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"query = \"\"\"(SELECT \r\n",
					"              presaincarico_data\r\n",
					"              ,tipologia_notifica\r\n",
					"              ,CAST(CONCAT(year, RIGHT(CONCAT('0',month),2)) as int) as AnnoMese\r\n",
					"              ,count(*) as NumNotifiche\r\n",
					"              ,sum(cost_eurocent) as CostoNotifiche\r\n",
					"            FROM (SELECT \r\n",
					"                    CASE WHEN notificationtype = 'DIGITALE' THEN LEFT(notification_sent_at,7)\r\n",
					"                    ELSE LEFT(event_timestamp,7)\r\n",
					"                    END AS presaincarico_data\r\n",
					"                    ,CASE WHEN notificationtype <> 'DIGITALE' THEN 'ANALOGICO'\r\n",
					"                      ELSE 'DIGITALE'\r\n",
					"                    END AS tipologia_notifica\r\n",
					"                    ,cost_eurocent\r\n",
					"                    ,year\r\n",
					"                    ,month\r\n",
					"                  FROM pfd.Notifiche \r\n",
					"                  WHERE TipologiaFattura in ('PRIMO SALDO','SECONDO SALDO')) t\r\n",
					"            group by year,month,presaincarico_data,tipologia_notifica) as tb\"\"\"\r\n",
					"            \r\n",
					"dfPerfezionate = spark.read.jdbc(url=jdbcUrl, table=query, properties=conn_Prop)"
				],
				"execution_count": null
			},
			{
				"cell_type": "code",
				"metadata": {
					"jupyter": {
						"source_hidden": false,
						"outputs_hidden": false
					},
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"dfTotale = dfPreseInCarico.join(dfPerfezionate, on=[\"presaincarico_data\",\"tipologia_notifica\"],how=\"left\")"
				],
				"execution_count": null
			},
			{
				"cell_type": "code",
				"metadata": {
					"jupyter": {
						"source_hidden": false,
						"outputs_hidden": false
					},
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"dfPivot = dfTotale.groupBy(\"presaincarico_data\", \"tipologia_notifica\").pivot(\"AnnoMese\").agg(F.sum(\"NumNotifiche\").alias(\"NumNotifiche\"), F.sum(\"CostoNotifiche\").alias(\"CostoNotifiche\"))"
				],
				"execution_count": null
