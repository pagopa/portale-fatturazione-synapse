						}
					}
				},
				"source": [
					"dfContestate = dfContestate.withColumn(\"AnnoMese_Contestazione\", F.concat(F.col(\"AnnoMese\"), F.lit(\"_\"), F.col(\"stato_contestazione\")))"
				],
				"execution_count": null
			},
