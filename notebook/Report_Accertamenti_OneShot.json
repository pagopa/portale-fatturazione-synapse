				"source": [
					"tipo_report = \"Fatturato_vs_Preseincarico\"\n",
					"# tipo_report = \"Contestato_vs_Preseincarico\"\n",
					"# tipo_report = \"Asseverazione_vs_Preseincarico\"\n",
					"# tipo_report = \"FatturatoAsseverazione_vs_Preseincarico\""
