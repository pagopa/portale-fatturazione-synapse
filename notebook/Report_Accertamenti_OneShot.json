					}
				},
				"source": [
					"asseverate = \"\"\"where TipologiaFattura = 'ASSEVERAZIONE'\"\"\"\n",
					"contestate = \"\"\"inner join pfw.Contestazioni c on n.event_id = c.FkIdNotifica\"\"\"\n",
					"fatturate = \"\"\"where TipologiaFattura IS NOT NULL AND TipologiaFattura <> 'ASSEVERAZIONE'\"\"\"\n",
					"fatturate_asseverate = \"\"\"where TipologiaFattura IS NOT NULL\"\"\""
				],
				"execution_count": 27
			},
			{
				"cell_type": "code",
				"metadata": {
					"jupyter": {
						"source_hidden": false,
						"outputs_hidden": false
					},
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"if tipo_report == \"Fatturato_vs_Preseincarico\":\n",
					"    filtro_notifiche = fatturate\n",
					"elif tipo_report == \"Contestato_vs_Preseincarico\":\n",
					"    filtro_notifiche = contestate\n",
					"elif tipo_report == \"Asseverazione_vs_Preseincarico\":\n",
					"    filtro_notifiche = asseverate\n",
					"elif tipo_report == \"FatturatoAsseverazione_vs_Preseincarico\":\n",
					"    filtro_notifiche = fatturate_asseverate"
				],
				"execution_count": 28
			},
			{
				"cell_type": "markdown",
				"metadata": {
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"## Prendo dal db di fatturazione le notifiche filtrate"
				]
			},
			{
				"cell_type": "code",
				"metadata": {
					"jupyter": {
						"source_hidden": false,
						"outputs_hidden": false
					},
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"query = f\"\"\"(\n",
					"select\n",
					"case\n",
					"when event_id like '%.PG%' or event_id like '%.PF%' then left(event_id, len(event_id) - len(recipient_id) - 1)\n",
					"    else event_id\n",
					"end as event_id\n",
					",iun as iun_sql\n",
					",recipient_id\n",
					",cost_eurocent\n",
					",'01/'+ SUBSTRING(n.invoincingtimestamp, 6,2) +'/2024' AS data_fatturazione\n",
					",CASE\n",
					"\t\tWHEN n.notificationtype <> 'DIGITALE' THEN 'ANALOGICO'\n",
					"\t\tELSE 'DIGITALE'\n",
					"\t\tEND AS notificationtype\n",
					"from pfd.Notifiche n\n",
					"where month = {anno_mese[5:]} and year = {anno_mese[:4]} and internal_organization_id <> '4a4149af-172e-4950-9cc8-63ccc9a6d865') as tb\"\"\""
				],
				"execution_count": 116
			},
			{
				"cell_type": "code",
				"source": [
					"# get the function to retrieve sql properties\n",
					"%run Utility/getSQLConnectionString\n",
