							"deleting": false
						}
					}
				},
				"source": [
					" ## PreseInCaricoVSFiltrate"
				]
			},
			{
				"cell_type": "code",
				"metadata": {
					"jupyter": {
						"source_hidden": false,
						"outputs_hidden": false
					},
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"report = spark.sql(\"\"\"\n",
					"WITH sender AS (\n",
					"\tSELECT\n",
					"\t\tdistinct\n",
					"\t\t  internalistitutionid as senderpaid,\n",
					"\t\t  description as senderdenomination\n",
					"\tFROM \n",
					"\t\t\tfat_delta.enti\n",
					"), all_preseincarico_costipassivi_map AS (\n",
					"    SELECT \n",
					"        iun,\n",
					"        paid as id_ente,\n",
					"        notification_cluster as tipologia_notifica,\n",
					"        data_fatturazione,\n",
					"        takenincharge_date as presaincarico_data,\n",
					"        price_paid as prezzo_ente,\n",
					"        paper_productType as analogico_prodotto,\n",
					"        cast(paper_numberOfPages as int) as analogico_totale_pagine,\n",
					"        CASE\n",
					"            WHEN paper_envelopeWeight BETWEEN 1 AND 20 THEN 1\n",
					"            WHEN paper_envelopeWeight BETWEEN 21 AND 50 THEN 21\n",
					"            WHEN paper_envelopeWeight BETWEEN 51 AND 100 THEN 51\n",
					"            WHEN paper_envelopeWeight BETWEEN 101 AND 250 THEN 101\n",
					"            WHEN paper_envelopeWeight BETWEEN 251 AND 350 THEN 251\n",
					"            WHEN paper_envelopeWeight BETWEEN 351 AND 1000 THEN 351\n",
					"            WHEN paper_envelopeWeight BETWEEN 1001 AND 2000 THEN 1001\n",
					"        END as analogico_totale_peso_gr_min,\n",
					"        CASE\n",
					"            WHEN paper_productType in ('RIS', 'RIR') THEN paper_dest_foreignState\n",
					"            ELSE paper_dest_zip\n",
					"        END as analogico_geokey\n",
					"    FROM \n",
					"        notifichefiltrateVSpreseincarico\n",
					"), all_preseincarico_costipassivi AS (\n",
					"    SELECT \n",
					"        iun,\n",
					"        id_ente,\n",
					"        data_fatturazione,\n",
					"        presaincarico_data,\n",
					"        tipologia_notifica,\n",
					"        prezzo_ente,\n",
					"        lotto,\n",
					"        recapitista,\n",
					"        CASE tipologia_notifica\n",
					"            WHEN 'ANALOGICO' THEN costo_plico + (analogico_totale_pagine-1)*costo_foglio\n",
					"            ELSE 0\n",
					"        END as costo_consolidatore,\n",
					"        CASE tipologia_notifica\n",
					"            WHEN 'ANALOGICO' THEN (costo + costo_demat)\n",
					"            ELSE 0\n",
					"        END as costo_recapitista\n",
					"    FROM\n",
					"        all_preseincarico_costipassivi_map a\n",
					"    LEFT JOIN TmpMatriceRecapitisti c\n",
					"    ON a.analogico_prodotto=c.product \n",
					"        AND (a.analogico_geokey = c.geokey or a.analogico_geokey = c.foreign_state)\n",
					"        AND a.analogico_totale_peso_gr_min=c.min\n",
					"        AND a.presaincarico_data >= c.dataInizioValidita AND a.presaincarico_data <= dataFineValidita\n",
					"\n",
					")\n",
					"SELECT\n",
					"    id_ente,\n",
					"    s.senderdenomination as ente,\n",
					"    data_fatturazione,\n",
					"    CONCAT('01/', SUBSTRING(presaincarico_data,6,2),'/', SUBSTRING(presaincarico_data, 1,4)) as presaincarico_data, \n",
					"    tipologia_notifica,\n",
					"    sum(prezzo_ente)/100 as tot_prezzo_ente,\n",
					"    count(*) as tot_notifiche,\n",
					"    sum(costo_consolidatore)/100 as tot_costo_consolidatore,\n",
					"    sum(costo_recapitista)/100 as tot_costo_recapitista,\n",
					"    CASE WHEN tipologia_notifica = 'ANALOGICO' THEN (sum(prezzo_ente)-(sum(costo_consolidatore)+sum(costo_recapitista)))/100\n",
					"    ELSE NULL END as tot_delta_costo\n",
					"FROM \n",
					"    all_preseincarico_costipassivi JOIN sender s\n",
					"    ON id_ente=s.senderpaid\n",
					"GROUP BY data_fatturazione,\n",
					"    id_ente,\n",
					"    s.senderdenomination,\n",
					"    presaincarico_data,\n",
					"    tipologia_notifica\n",
					"\"\"\")"
				],
				"execution_count": 91
			},
