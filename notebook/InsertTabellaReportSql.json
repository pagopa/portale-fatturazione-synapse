				"source": [
					"def sha256OfFile(file_path):\n",
					"    sha256_hash = hashlib.sha256()\n",
					"    with open(file_path, \"rb\") as f:\n",
					"        for byte_block in iter(lambda: f.read(4096), b\"\"):\n",
					"            sha256_hash.update(byte_block)\n",
					"    return sha256_hash.hexdigest()"
				],
				"execution_count": null
			},
			{
				"cell_type": "code",
				"metadata": {
					"jupyter": {
						"source_hidden": false,
						"outputs_hidden": false
					},
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"tmp_path=\"\"\n",
					"contentType = \"text/csv\"\n",
					"container = \"reportaccertamenti\"\n",
					"\n",
					"if \".json\" in path:\n",
					"    tmp_path = 'file:/tmp/temp/report.json'\n",
					"    contentType = \"application/json\"\n",
					"    linkDocumento = f\"jsonaccertamenti/{path[54:]}\"\n",
					"else:\n",
					"    tmp_path = 'file:/tmp/temp/report.csv'\n",
					"    contentType = \"text/csv\"\n",
					"    linkDocumento = f\"reportaccertamenti/{path[56:]}\"\n",
					"\n",
					"mssparkutils.fs.cp(path, tmp_path)\n",
					"\n",
					"df = spark.createDataFrame(\n",
					"data = [(None\n",
					",int(anno)\n",
					",int(mese)\n",
					",\"prod-pn\"\n",
					",2\n",
					",spark.sql(\"SELECT current_timestamp()\").collect()[0][0]\n",
					",None\n",
					",\"fatpdls\"\n",
					",linkDocumento\n",
					",\"it-IT\"\n",
					",contentType #\"text/csv\"\n",
					",sql_id\n",
					",sha256OfFile(tmp_path[5:]))]\n",
					"\n",
					",schema = spark.read.jdbc(url=jdbcUrl, table=\"(select * from pfd.report) as tb\", properties=conn_Prop).schema[1:]\n",
					")\n",
					"\n",
					"mssparkutils.fs.rm(tmp_path)\n",
					"\n",
					"df.write.jdbc(url=jdbcUrl, table=\"pfd.report\", mode = 'append', properties=conn_Prop)\n",
					"#count+=1"
				],
				"execution_count": null
			}
