				"source": [
					"#Attivazione modalità \"dynamic\" per la scrittura delle partizioni\r\n",
					"spark.conf.set(\"spark.sql.sources.partitionOverwriteMode\", \"dynamic\")"
				],
				"execution_count": 17
			},
			{
				"cell_type": "code",
				"metadata": {
					"jupyter": {
						"source_hidden": false,
						"outputs_hidden": false
					},
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"def add_to_history_table(df, table, current_date):\r\n",
					"\r\n",
					"    df_daily = df.withColumn(\"data_elaborazione\", F.lit(current_date))\r\n",
					"\r\n",
					"    tablename = f\"{table}_daily\"\r\n",
					"\r\n",
					"    try:\r\n",
					"        if spark.sql(f\"SELECT count(*) FROM {tablename} WHERE data_elaborazione = '{current_date}'\").collect()[0][0] == 0:\r\n",
					"\r\n",
					"            write_mode = \"append\"\r\n",
					"        else:\r\n",
					"            write_mode = \"overwrite\"\r\n",
					"\r\n",
					"        partition_key = \"data_elaborazione\"\r\n",
					"\r\n",
					"        df_daily\\\r\n",
					"            .repartition(partition_key)\\\r\n",
					"            .write.mode(write_mode)\\\r\n",
					"            .format(\"delta\")\\\r\n",
					"            .partitionBy(partition_key)\\\r\n",
					"            .saveAsTable(tablename)\r\n",
					"        \r\n",
					"        return f\"Data written in {write_mode} mode in the table {tablename} for day {current_date}\";\r\n",
					"    except Exception as e:\r\n",
					"        return f\"{tablename} doesn't exist yet\""
				],
				"execution_count": 1
			}
		]
	}
}