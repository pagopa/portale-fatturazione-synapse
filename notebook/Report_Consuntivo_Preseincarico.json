				"source": [
					"from pyspark.sql import functions as F\r\n",
					"from pyspark.sql import Window"
				],
				"execution_count": 60
			},
			{
				"cell_type": "code",
				"metadata": {
					"jupyter": {
						"source_hidden": false,
						"outputs_hidden": false
					},
					"nteract": {
