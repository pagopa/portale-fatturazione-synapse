				"source": [
					"# Invia la mail\r\n",
					"with smtplib.SMTP(smtp_server, port) as server:\r\n",
					"    server.starttls()\r\n",
					"    server.login(sender_email, password)\r\n",
					"    response = server.sendmail(sender_email, receiver_email, msg.as_string())\r\n",
					"    "
