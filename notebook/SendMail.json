						}
					}
				},
				"source": [
					"html_content = \"\"\"\r\n",
					"<html>\r\n",
					"    <body>\r\n",
					"        <h2>Titolo del messaggio</h2>\r\n",
					"        <p>Questo è un paragrafo con <b>testo in grassetto</b> e <i>corsivo</i>.</p>\r\n",
					"        <p>Scarica il documento </p>\r\n",
					"    </body>\r\n",
					"</html>\r\n",
					"\"\"\"\r\n",
					"msg.attach(MIMEText(html_content, 'html'))"
				],
				"execution_count": 9
			},
