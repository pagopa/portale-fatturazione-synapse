				"source": [
					"# leggere da keyvault\r\n",
					"smtp_server = 'smtp.gmail.com'\r\n",
					"port = 587\r\n",
					"sender_email = 'email@gmail.com'\r\n",
					"receiver_email = 'test@porini.it'\r\n",
					"password = 'test'"
				],
				"execution_count": 7
			},
			{
				"cell_type": "code",
				"metadata": {
