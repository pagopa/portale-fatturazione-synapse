							"deleting": false
						}
					}
				},
				"source": [
					"# Crea il messaggio\r\n",
					"msg = MIMEMultipart()\r\n",
					"msg['Subject'] = 'Oggetto della mail'\r\n",
					"msg['From'] = sender_email\r\n",
					"msg['To'] = receiver_email"
				],
				"execution_count": 8
			},
			{
				"cell_type": "code",
				"metadata": {
					"jupyter": {
						"source_hidden": false,
