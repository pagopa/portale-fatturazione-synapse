						}
					}
				},
				"source": [
					"# receiver_emails = ['RECIPIENT1_EMAIL_ADDRESS', 'RECIPIENT2_EMAIL_ADDRESS']\r\n",
					"# cc_emails = ['CC_RECIPIENT1_EMAIL_ADDRESS', 'CC_RECIPIENT2_EMAIL_ADDRESS']\r\n",
					"# msg['To'] = ', '.join(receiver_emails)\r\n",
