					"tags": [
						"parameters"
					]
				},
				"source": [
					"anno_mese = ''"
				],
				"execution_count": null
			},
			{
				"cell_type": "code",
				"metadata": {
					"jupyter": {
						"source_hidden": false,
						"outputs_hidden": false
					},
					"nteract": {
						"transient": {
							"deleting": false
						}
					},
					"tags": []
				},
				"source": [
					"mese = anno_mese[5:]\r\n",
					"anno = anno_mese[:4]\r\n",
					"tipo_report = 'PerfezionateAsseverazione'"
				],
				"execution_count": 95
			},
			{
				"cell_type": "code",
				"metadata": {
					"jupyter": {
						"source_hidden": false,
						"outputs_hidden": false
					},
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"query = f\"\"\"(\r\n",
					"select \r\n",
					"    n.internal_organization_id as id_ente,\r\n",
					"    e.description as ente, \r\n",
					"    left(n.notification_sent_at , 7) as data_presa_in_carico,\r\n",
					"    concat(cast(n.year as varchar(5)),'-', FORMAT(n.month, '00')) as data_fatturazione,\r\n",
					"    count(*) as tot_notifiche,\r\n",
					"    sum(n.cost_eurocent/100) as tot_prezzo_ente\r\n",
					"from pfd.Notifiche n \r\n",
					"left join pfd.Enti e on n.internal_organization_id = e.InternalIstitutionId \r\n",
					"WHERE \r\n",
					"n.month = '{mese}'\r\n",
					"AND \r\n",
					"n.year = '{anno}'\r\n",
					"AND \r\n",
					"n.tipologiafattura = 'asseverazione'\r\n",
					"AND \r\n",
					"n.cost_eurocent != 0\r\n",
					"group by n.internal_organization_id, e.description, left(n.notification_sent_at , 7), n.month, n.year) as tb\"\"\""
				],
				"execution_count": 96
			},
			{
				"cell_type": "code",
				"source": [
					"# get the function to retrieve sql properties\r\n",
					"%run Utility/getSQLConnectionString\r\n",
					"\r\n",
					"# retrieve sql connection_string and connection_properties\r\n",
					"jdbcUrl,conn_Prop = getSQLConnectionString()"
				],
				"execution_count": null
			},
			{
				"cell_type": "code",
				"metadata": {
					"jupyter": {
						"source_hidden": false,
						"outputs_hidden": false
					},
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"report = spark.read.jdbc(url=jdbcUrl, table=query, properties=conn_Prop)"
				],
				"execution_count": 97
			},
			{
				"cell_type": "code",
				"metadata": {
					"jupyter": {
						"source_hidden": false,
						"outputs_hidden": false
					},
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"def sum_col(df, col):\r\n",
					"    return df.select(F.sum(col)).collect()[0][0]"
				],
				"execution_count": 98
			},
			{
				"cell_type": "code",
				"metadata": {
					"jupyter": {
						"source_hidden": false,
						"outputs_hidden": false
					},
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"totali = spark.createDataFrame([(\"\",\"\",\"\",\"\",\r\n",
					"sum_col(report, 'tot_notifiche'),\\\r\n",
					"sum_col(report, 'tot_prezzo_ente'))],\r\n",
					"report.schema)"
				],
				"execution_count": 100
			},
			{
				"cell_type": "code",
				"metadata": {
					"jupyter": {
						"source_hidden": false,
						"outputs_hidden": false
					},
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"report = report.union(totali)"
				],
				"execution_count": 101
			},
