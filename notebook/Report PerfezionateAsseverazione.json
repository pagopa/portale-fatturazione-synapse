				"source": [
					"## Caricamento Report su Storage Account Fatpdls-ReportAccertamenti"
				]
			},
			{
				"cell_type": "code",
				"metadata": {
					"jupyter": {
						"source_hidden": false,
						"outputs_hidden": false
					},
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"file_path = f\"abfss://reportaccertamenti@fatpdls.dfs.core.windows.net/{tipo_report}/{anno_mese}\""
				],
				"execution_count": 102
			},
			{
				"cell_type": "code",
				"metadata": {
					"jupyter": {
						"source_hidden": false,
						"outputs_hidden": false
					},
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"report.repartition(1).write.options(header = True, delimiter = ',').mode('overwrite').csv(file_path)"
				],
				"execution_count": 103
			},
			{
				"cell_type": "code",
				"metadata": {
					"jupyter": {
						"source_hidden": false,
						"outputs_hidden": false
					},
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"path_list = []\r\n",
					"\r\n",
					"for folder in mssparkutils.fs.ls(file_path[:-7]):\r\n",
					"    if anno_mese in folder.path:\r\n",
					"        for file in mssparkutils.fs.ls(folder.path):\r\n",
					"            if file.name == '_SUCCESS':\r\n",
					"                mssparkutils.fs.rm(file.path)\r\n",
					"                1\r\n",
					"            else:\r\n",
					"                path_list.append(folder.path+f\"/Report_{tipo_report}_\"+folder.path[len(file_path)-7:]+\".csv\")\r\n",
					"                mssparkutils.fs.mv(file.path, folder.path+f\"/Report_{tipo_report}_\"+folder.path[len(file_path)-7:]+\".csv\", True)"
				],
				"execution_count": 104
			},
			{
				"cell_type": "markdown",
				"metadata": {
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"## Scrittura su fat_delta"
				]
			},
			{
				"cell_type": "code",
				"metadata": {
					"jupyter": {
						"source_hidden": false,
						"outputs_hidden": false
					},
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"try:\r\n",
					"    maxProgressivoDf = spark.sql(f\"select max(id) as id from fat_delta.{tipo_report} where left(presaincarico_data,4) = '{anno}'\")\r\n",
					"    if maxProgressivoDf.count() >0:\r\n",
					"         maxProgressivo = maxProgressivoDf.collect()[0]['id'] \r\n",
					"    else:\r\n",
					"         maxProgressivo = 0\r\n",
					"except:\r\n",
					"    maxProgressivo = 0"
				],
				"execution_count": 105
			},
			{
				"cell_type": "code",
				"metadata": {
					"jupyter": {
						"source_hidden": false,
						"outputs_hidden": false
					},
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"report = report.withColumn('id', F.dense_rank().over(Window.orderBy('id_ente')) + F.lit(maxProgressivo))"
				],
				"execution_count": 106
			},
			{
				"cell_type": "code",
				"metadata": {
					"jupyter": {
						"source_hidden": false,
						"outputs_hidden": false
					},
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"report.where(\"id_ente <> ''\").write.format(\"delta\").mode(\"append\").saveAsTable(\"fat_delta.\"+tipo_report)"
				],
				"execution_count": 107
			},
			{
				"cell_type": "markdown",
				"metadata": {
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
