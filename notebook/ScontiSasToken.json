					}
				},
				"source": [
					"dfScontiQuarter = spark.sql(f\"SELECT * FROM pagopa.financial_report_sconti WHERE year_quarter='{year_quarter}'\")\r\n",
					"\r\n",
					"dfScontiQuarterDistinct = dfScontiQuarter.select(\"recipient_id\").distinct()"
				],
				"execution_count": 51
			},
			{
				"cell_type": "code",
				"metadata": {
					"jupyter": {
						"source_hidden": false,
						"outputs_hidden": false
					},
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"%run PagoPA/SendMail/GenerateSASToken_def"
				],
				"execution_count": 52
			},
			{
				"cell_type": "code",
				"metadata": {
					"jupyter": {
						"source_hidden": false,
						"outputs_hidden": false
					},
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"report_name = str(reference_year) + \"-q\" + str(reference_quarter) + \"-KpiPagamenti_Sconto.csv\"\r\n",
					"\r\n",
					"container_list = []\r\n",
					"for row in dfScontiQuarterDistinct.rdd.toLocalIterator():\r\n",
					"    kpiPagamentiReport = generateSAStoken(\"fatppublic\",\"invoices\",f\"{row.recipient_id}/{report_name}\")\r\n",
					"    #spark.sql(f\"UPDATE pagopa.financial_report_sconti SET linkReport = '{kpiPagamentiReport}' WHERE recipient_id = '{row.recipient_id}'\")\r\n",
					"    container_list.append(\r\n",
					"        [row.recipient_id, kpiPagamentiReport]\r\n",
					"    )\r\n",
					"\r\n",
					"if len(container_list) != 0:\r\n",
					"    dfLinkReport = spark.createDataFrame(container_list)\r\n",
					"else:\r\n",
					"    schema = StructType([StructField('_1', StringType(), True), StructField('_2', StringType(), True)])\r\n",
					"    dfLinkReport = spark.createDataFrame([], schema)\r\n",
					""
				],
				"execution_count": 53
			},
			{
				"cell_type": "code",
				"metadata": {
					"jupyter": {
						"source_hidden": false,
						"outputs_hidden": false
					},
					"nteract": {
						"transient": {
							"deleting": false
						}
					},
					"collapsed": false
				},
				"source": [
					"dfLinkReport = dfLinkReport.withColumnRenamed(\"_1\",\"recipient_id\").withColumnRenamed(\"_2\",\"linkReportOK\")"
				],
				"execution_count": 54
			},
			{
				"cell_type": "code",
				"metadata": {
					"jupyter": {
						"source_hidden": false,
						"outputs_hidden": false
					},
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"dfScontiQuarter = dfScontiQuarter.join(dfLinkReport,on=\"recipient_id\", how=\"inner\")\r\n",
					"dfScontiQuarter = dfScontiQuarter.drop(\"linkReport\")\r\n",
					"dfScontiQuarter = dfScontiQuarter.withColumnRenamed(\"linkReportOK\",\"linkReport\")"
				],
				"execution_count": 55
			},
			{
				"cell_type": "code",
				"metadata": {
					"jupyter": {
						"source_hidden": false,
						"outputs_hidden": false
					},
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"partition_key = \"year_quarter\"\r\n",
					"table = \"pagopa.financial_report_sconti\"\r\n",
					"\r\n",
					"\r\n",
					"dfScontiQuarter.repartition(partition_key)\\\r\n",
					"        .write.mode(\"overwrite\")\\\r\n",
					"        .format(\"delta\")\\\r\n",
					"        .partitionBy(partition_key)\\\r\n",
					"        .option(\"mergeSchema\", \"true\")\\\r\n",
					"        .saveAsTable(table)"
				],
				"execution_count": 79
			}
